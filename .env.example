# 복사해서 .env 로 사용 (cp .env.example .env). .env 는 절대 커밋하지 마세요.
# 로컬 실행: npm run dev  /  초기 데이터 시드: npm run seed  (둘 다 .env 자동 로드)

PORT=4000

# ---- Supabase (필수) ----
# 대시보드 → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
# service_role 키 (서버 전용 비밀키). anon 키가 아님! RLS 로 anon 접근이 막혀 있으므로 anon 키로는 동작하지 않습니다.
# 프론트엔드/저장소/채팅/로그에 절대 노출하지 마세요. 유출되면 Supabase 에서 즉시 재발급(Rotate)하세요.
SUPABASE_KEY=

# ---- 접근 암호 (HTTP Basic) ----
# 설정하면 /api/health 를 제외한 모든 경로가 보호됩니다. 공개 URL로 배포할 때는 필수
# (NODE_ENV=production 에서 없으면 서버가 시작을 거부하고 오류 메시지를 응답)
BASIC_AUTH_USER=gbsa
BASIC_AUTH_PASS=

# ---- 사번 로그인 (앱 로그인 페이지 /login) ----
# 아이디 = 사원 DB 사번, 초기 비밀번호 = 사번과 동일. 세션은 서명된 HttpOnly 쿠키(8시간)로 유지된다.
# 세션 서명 키: 지정하지 않으면 SUPABASE_KEY 에서 파생(추가 설정 불필요). 별도로 두려면 임의의 긴 문자열을 지정.
# SESSION_SECRET=
# 관리자 모드(관리자 탭/관리자 API/타인 업무 조회)를 허용할 소속 부서(쉼표 구분). 기본값: 기획조정실,인사총무팀
# ADMIN_DEPTS=기획조정실,인사총무팀

# ---- 제출 요청 이메일 (관리자 모드 [제출 요청] 버튼, Resend REST API · HTTPS 443 · 무료 플랜) ----
# https://resend.com 가입 → API Keys 에서 발급. 무료 플랜(월 3,000통/일 100통)으로 충분합니다.
RESEND_API_KEY=
# 발신 주소. 도메인을 인증하지 않았다면 반드시 onboarding@resend.dev (기본값)
SENDER_EMAIL=onboarding@resend.dev
# 시연용 수신 주소(1~3개, 쉼표 구분). 이 주소로만 발송되며 사원 본인에게는 절대 보내지 않습니다.
#  ※ Resend 무료 플랜은 도메인 미인증 시 '가입한 본인 이메일'로만 발송할 수 있습니다(다른 주소는 403).
REMINDER_TEST_RECIPIENTS=
# 메일 버튼이 여는 배포 주소(선택). 비우면 요청 Host 로 자동 결정. 예: https://your-app.vercel.app
# APP_URL=

# (참고) 로그인 없이 기본 사원을 고르던 옛 방식용 — 로그인 도입 후에는 사용되지 않음
DEMO_USER_EMPNO=

# 선택: true 면 교육 수료증 업무도 [제출완료] 수동 제출을 허용 (기본: 수료증 업로드 + 본인 성명 검증으로만 제출 가능)
# ALLOW_MANUAL_EDU_SUBMIT=false

# 선택: 프론트를 다른 도메인에서 호출할 때만 (쉼표 구분)
# CORS_ORIGIN=https://your-app.vercel.app
