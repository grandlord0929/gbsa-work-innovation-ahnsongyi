# 복사해서 .env 로 사용 (cp .env.example .env). .env 는 절대 커밋하지 마세요.
# 로컬 실행: npm run dev  (.env 자동 로드)

PORT=4000

# 접근 암호 (HTTP Basic). 설정하면 /api/health 를 제외한 모든 경로가 보호됩니다.
# 공개 URL로 배포할 때는 필수 (NODE_ENV=production 에서 없으면 서버가 시작되지 않음)
BASIC_AUTH_USER=gbsa
BASIC_AUTH_PASS=

# 직원 모드 기본 로그인 사번 (비우면 '홍길동' → 바이오센터 첫 사원)
DEMO_USER_EMPNO=

# 선택: 파일 위치 변경 (영구 디스크를 붙인 경우)
# DATA_DIR=/var/data
# EMPLOYEES_XLSX=/var/data/employees.xlsx

# 선택: 프론트를 다른 도메인에서 호출할 때만 (쉼표 구분)
# CORS_ORIGIN=https://your-app.vercel.app
